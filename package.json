{
  "name": "deziner",
  "displayName": "deziner",
  "description": "Deziner is a code-native design tool to bridge the gap between design and development",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "deziner.visualEditor",
        "displayName": "Deziner Visual Editor",
        "selector": [
          {
            "filenamePattern": "**/*.deziner.html"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "deziner.open",
        "title": "Opening Deziner"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "npm run build:webview && tsc -watch -p ./",
    "build:webview": "npm --prefix webview-ui run build",
    "watch:webview": "npm --prefix webview-ui run build -- --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
